# frpc Web 配置界面 · 纯前端网关配置
# ${RESOLVER} / ${FRPC_UPSTREAM} 由 nginx 官方镜像 envsubst 机制注入
# （只替换已定义的环境变量；$target/$http_x_frpc_target 等 nginx 变量不受影响）
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ----------------------------
    # DNS 解析器：变量 proxy_pass 运行时解析目标域名，必须显式指定
    # 127.0.0.11 = Docker 内置 DNS（容器名/服务名可达），后两个兜底公网域名
    # ----------------------------
    resolver ${RESOLVER} valid=300s;
    resolver_timeout 5s;

    # 前端静态文件 + SPA 回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ----------------------------
    # 后端 API 代理：目标地址由前端 X-Frpc-Target 请求头动态指定
    # （面板连接设置里填的地址 = 真正的 frpc webServer；一个面板可连任意多个 frpc）
    # ----------------------------
    location /api/ {
        set $target $http_x_frpc_target;

        # 头为空时回退到默认目标（未在面板里设置连接信息时）
        if ($target = "") {
            set $target "${FRPC_UPSTREAM}";
        }

        proxy_pass $target;

        # https 目标支持（SNI，不做证书校验）
        proxy_ssl_server_name on;
        proxy_ssl_verify off;

        # 基本头部：Host 用实际目标，透传 Authorization（面板连接凭据）
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 超时（管理 API 响应慢时可调大）
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        # 流式响应不缓冲
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # ----------------------------
    # gzip + 静态资源缓存
    # ----------------------------
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}
